    "container:test": "scripts/container-test.sh"
  },
  "private": true,
  "devDependencies": {
    "@nx/js": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "^0.5.23",
    "@types/node": "^24.13.6",
    "nx": "23.3.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "pkg/*"
  ],
  "dependencies": {
    "avsc": "^5.7.9"
  }
}
