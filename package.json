  "license": "MIT",
  "scripts": {
    "build": "npm run build -w @sc-voice/tools && npm run build -w @sc-voice/nameforma",
    "clean": "rm -rf tsconfig.tsbuildinfo && npm run clean --workspaces --if-present",
