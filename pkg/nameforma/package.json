{
  "name": "@sc-voice/nameforma",
  "version": "0.3.0",
  "description": "Personal Reality Manager (PRM) framework for Human/Agentic cooperation",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unstable": {
      "types": "./dist/unstable.d.ts",
      "import": "./dist/unstable.js"
    }
  },
  "files": [
    "LICENSE",
    "index.mjs",
    "package.json",
    "README.md",
    "src",
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "npm run build:ts && npm run build:doc",
    "build:ts": "npx tsc && chmod +x dist/cli/nf-cli.js",
    "build:typecheck": "npm run build && npx tsc -p tsconfig.test.json",
    "build:tsw": "npx tsc --watch",
    "build:doc": "./scripts/build-doc.sh",
    "format": "npx biome format --write src test",
    "test": "npm run build:typecheck && npm run test:unit && npm run format",
    "test:unit": "npm run build:typecheck && vitest --config test/vitest.config.mjs run --project=unit",
    "test:test": "npm run build:typecheck && vitest --config test/vitest.config.mjs watch --project=unit",
    "test:integration": "npm run tansu:start && npm run build && vitest run --config test/vitest.config.mjs --project=integration",
    "tansu:install": "./scripts/tansu-install",
    "tansu:start": "./scripts/tansu-start",
    "tansu:stop": "./scripts/tansu-stop",
    "cli": "node dist/cli/nf-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sc-voice/nx-scv.git"
  },
  "keywords": [
    "SC-Voice",
    "nx-scv",
    "NameForma",
    "Javascript"
  ],
  "author": "Karl Lew",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sc-voice/nx-scv/issues"
  },
  "homepage": "https://github.com/sc-voice/nx-scv/packages/nameforma/#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@sc-voice/vitest": "^4.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.8.0",
    "hjson": "^3.2.2"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.74.0",
    "@sc-voice/tools": "*",
    "avro-js": "^1.12.0",
    "bubbly": "^1.1.2",
    "commander": "^12.1.0",
    "kafkajs": "^2.2.4",
    "minimatch": "^10.2.5",
    "pino": "^9.4.0",
    "rotating-file-stream": "^3.1.1",
    "uuid": "^14.0.0"
  },
  "bin": {
    "nameforma": "dist/cli/nf-cli.js",
    "nf": "dist/cli/nf-cli.js"
  }
}
