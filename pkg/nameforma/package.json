{
  "name": "@sc-voice/nx-nf",
  "version": "0.1.0",
  "description": "SC-Voice Agent Task Manager",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "LICENSE",
    "index.mjs",
    "package.json",
    "README.md",
    "src",
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "npm run build:ts && npm run build:doc",
    "build:ts": "npx tsc && chmod +x dist/cli/nf-cli.js",
    "build:doc": "./scripts/build-doc.sh",
    "format": "npx biome format --write src test",
    "test": "npm run test:unit",
    "test:unit": "npm run build && vitest --config test/vitest.config.mjs run --project=unit",
    "test:test": "npm run build && vitest --config test/vitest.config.mjs watch",
    "test:integration": "npm run tansu:start && npm run build && vitest run --config test/vitest.config.mjs --project=integration",
    "tansu:install": "./scripts/tansu-install",
    "tansu:start": "./scripts/tansu-start",
    "tansu:stop": "./scripts/tansu-stop",
    "cli": "node dist/cli/nf-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sc-voice/nx-scv.git"
  },
  "keywords": [
    "SC-Voice",
    "nx-scv",
    "NameForma",
    "Javascript"
  ],
  "author": "Karl Lew",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sc-voice/nx-scv/issues"
  },
  "homepage": "https://github.com/sc-voice/nx-scv/packages/nameforma/#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@sc-voice/vitest": "^4.0.0",
    "eslint": "^9.17.0"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "^0.70.6",
    "@sc-voice/tools": "*",
    "avro-js": "^1.12.0",
    "bubbly": "^1.1.2",
    "commander": "^12.1.0",
    "kafkajs": "^2.2.4"
  },
  "bin": {
    "nameforma": "dist/cli/nf-cli.js",
    "nf": "dist/cli/nf-cli.js"
  }
}
