{
  "name": "@sc-voice/tools",
  "version": "4.0.0",
  "description": "Utilities for SC-Voice",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./math": "./dist/math/index.js",
    "./text": "./dist/text/index.js",
    "./util": "./dist/util/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "package.json",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "npx tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "format": "npx biome format --write src test",
    "test": "npm run build && vitest run --config test/vitest.config.mjs",
    "test:test": "npm run build && vitest --config test/vitest.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sc-voice/nx-scv.git"
  },
  "keywords": [
    "SC-Voice",
    "nx-scv",
    "Tools",
    "Javascript"
  ],
  "author": "Karl Lew",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sc-voice/nx-scv/issues"
  },
  "homepage": "https://github.com/sc-voice/nx-scv/pkg/tools/#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@sc-voice/vitest": "^4.0.0",
    "@types/node": "^24.12.2",
    "avro-js": "^1.12.0",
    "eslint": "^9.17.0",
    "typescript": "~5.8.2"
  }
}
